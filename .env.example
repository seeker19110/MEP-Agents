# Chọn hệ sinh thái AI mặc định (openai, groq, gemini, anthropic, hoặc ollama)
LLM_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile

# Cấu hình API Key (Điền key tương ứng với LLM_PROVIDER bạn chọn)
OPENAI_API_KEY=sk-xxxxxx
GROQ_API_KEY=gsk_xxxxxx
GOOGLE_API_KEY=AIzaSy_xxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxx

# (Tùy chọn) Ghi đè provider/model riêng cho từng VAI TRÒ (agent) — nếu không đặt,
# vai trò đó sẽ dùng LLM_PROVIDER/MODEL_NAME ở trên. Xem khuyến nghị chi tiết theo
# từng vai trò trong AI_MODEL_SETUP.md. Ví dụ: giao vai trò CAD/QS (đòi hỏi suy luận
# hình học + tuân thủ quy tắc nghiêm ngặt) cho Claude Opus, còn Supervisor/Reviewer
# dùng Claude Sonnet để cân bằng chi phí:
# CAD_LLM_PROVIDER=anthropic
# CAD_MODEL_NAME=claude-opus-5
# QS_LLM_PROVIDER=anthropic
# QS_MODEL_NAME=claude-opus-5
# SUPERVISOR_LLM_PROVIDER=anthropic
# SUPERVISOR_MODEL_NAME=claude-sonnet-5
# REVIEWER_LLM_PROVIDER=anthropic
# REVIEWER_MODEL_NAME=claude-sonnet-5
# MECHANICAL_LLM_PROVIDER=anthropic
# MECHANICAL_MODEL_NAME=claude-sonnet-5
# ELECTRICAL_LLM_PROVIDER=anthropic
# ELECTRICAL_MODEL_NAME=claude-sonnet-5
# PLUMBING_LLM_PROVIDER=anthropic
# PLUMBING_MODEL_NAME=claude-sonnet-5
# FIREFIGHTING_LLM_PROVIDER=anthropic
# FIREFIGHTING_MODEL_NAME=claude-sonnet-5
# BIM_LLM_PROVIDER=anthropic
# BIM_MODEL_NAME=claude-sonnet-5
# (Có thể đặt riêng key cho từng vai trò nếu cần, ví dụ CAD_ANTHROPIC_API_KEY=...)

# (Tùy chọn, chỉ dùng với Anthropic) Bật Tool Search beta: thay vì nạp schema mọi tool,
# chỉ nạp tool tìm kiếm và để model tự tra tool cần dùng. Giảm token cho vai trò nhiều
# tool (Mechanical, CAD), nhưng là beta đặc thù Anthropic nên mặc định TẮT.
# ANTHROPIC_TOOL_SEARCH=true

# --- Vòng lặp tự sửa lỗi & bộ nhớ hội thoại ---
# Số lần Reviewer được TỪ CHỐI và bắt worker làm lại trên cùng một yêu cầu.
# Hết hạn mức, luồng dừng kèm cảnh báo "CHƯA ĐẠT" thay vì quay vòng vô tận.
MAX_REVIEW_RETRIES=2
# Trần số bước LangGraph mỗi lượt chạy (chốt chặn cuối cùng).
RECURSION_LIMIT=25
# File SQLite lưu lịch sử hội thoại. Để RỖNG nếu muốn dùng RAM (mất hết khi restart).
CHECKPOINT_DB=data/checkpoints.sqlite
# Số phiên bản bản vẽ CAD giữ lại cho MỖI file (mỗi phiên bản là một bản sao .dxf đầy đủ).
# Đặt 0 để giữ toàn bộ lịch sử, chấp nhận tốn dung lượng.
MAX_CAD_REVISIONS=3

# Database Configuration (Future use for Giai đoạn 2)
# DATABASE_URL=postgresql://user:password@localhost:5432/db_name

# --- FastAPI Cloud API (src/api.py) — xem TECH_DEBT.md mục 7 ---
# (Tùy chọn) Đặt để BẮT BUỘC mọi request tới API phải kèm header `X-API-Key` (hoặc query
# `?api_key=` cho endpoint tải file/WebSocket) khớp giá trị này. Không đặt = API vẫn mở
# hoàn toàn như trước (mặc định phù hợp máy dev cục bộ). BẮT BUỘC đặt trước khi để server
# public ra ngoài Internet — đây không phải xác thực người dùng thật (JWT/OAuth đa người
# dùng vẫn là việc của Phase 5/mục 6), chỉ là 1 khóa chung chặn truy cập nặc danh.
# MEP_AGENTS_API_KEY=doi-gia-tri-nay-truoc-khi-deploy
# (Tùy chọn) Danh sách origin CORS được phép, phân tách bằng dấu phẩy. Không đặt = mặc
# định chỉ cho phép Web App dev cục bộ (http://localhost:5173). Đặt domain Web App thật
# khi deploy production, KHÔNG dùng "*" (không hợp lệ khi kết hợp allow_credentials).
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__xxxxxx
LANGCHAIN_PROJECT=x_agents_project
