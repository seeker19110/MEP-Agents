# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxx
GROQ_API_KEY=gsk_xxxxxx
GOOGLE_API_KEY=AIzaSy_xxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxx
MODEL_NAME=gpt-4o-mini

RECURSION_LIMIT=25
CHECKPOINT_DB=data/checkpoints.sqlite
MAX_CAD_REVISIONS=3
# Số lần Reviewer bắt làm lại trước khi dừng và báo "CHƯA ĐẠT"
MAX_REVIEW_RETRIES=2

# Mỗi vai trò một model riêng: đặt tiền tố <VAI_TRÒ>_ trước tên biến.
# Vai trò: MECHANICAL, ELECTRICAL, PLUMBING, FIREFIGHTING, QS, CAD, BIM, REVIEWER, SUPERVISOR
# CAD_LLM_PROVIDER=groq
# CAD_MODEL_NAME=llama-3.3-70b-versatile
# REVIEWER_LLM_PROVIDER=anthropic

# Beta tool search của Anthropic (mặc định tắt)
# ANTHROPIC_TOOL_SEARCH=false

# --- LLM chạy cục bộ (LLM_PROVIDER=ollama hoặc vllm) ---
# Địa chỉ server. Không đặt thì mặc định localhost — nhớ đổi khi Ollama/vLLM nằm ở máy
# khác hoặc ở service khác trong Docker Compose ("localhost" trong container là chính nó).
# OLLAMA_BASE_URL dùng CHUNG với nguồn embedding bên dưới, viết không có đuôi /v1.
# OLLAMA_BASE_URL=http://ollama:11434
# VLLM_BASE_URL=http://gpu-box:8000
# VLLM_API_KEY=

# --- Tinh chỉnh hiệu năng ---
# Số message gần nhất gửi kèm mỗi lượt gọi LLM
# AGENT_MESSAGE_WINDOW=24
# Cắt bớt kết quả tool quá dài trước khi đưa vào ngữ cảnh
# MAX_TOOL_RESULT_CHARS=6000
# Số bản vẽ DXF giữ trong cache của tiến trình
# CAD_CACHE_MAX=8
# TTL (giây) cache đơn giá trong RAM
# UNIT_PRICE_MEM_TTL=300
# Quá bao nhiêu ngày thì cảnh báo bảng đơn giá đã cũ (0 = tắt cảnh báo).
# Ngày hiệu lực khai báo ở data/unit_prices.meta.json, KHÔNG lấy theo thời gian sửa file.
# UNIT_PRICE_MAX_AGE_DAYS=180

# --- Phase D: tìm kiếm lai + embedding cục bộ ---
# Nguồn embedding: openai | ollama | local. Bỏ trống = tự dò theo API key sẵn có.
# EMBEDDING_BACKEND=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# HYBRID_SEARCH=true

# --- Đường dẫn dữ liệu / công cụ ngoài ---
# STANDARDS_DIR=data/standards
# FAISS_INDEX_PATH=faiss_index
# ODA_CONVERTER_PATH=/usr/bin/ODAFileConverter

# --- Redis / Celery (Docker Compose tự đặt sẵn) ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# FastAPI legacy shared key (optional)
# MEP_AGENTS_API_KEY=doi-gia-tri-nay-truoc-khi-deploy
# CORS_ALLOWED_ORIGINS=https://app.example.com

# BẮT BUỘC khi chạy docker-compose. Redis vừa là broker vừa là result backend của Celery:
# ai ghi được vào đây là điều khiển được Worker, mà Worker đọc/ghi được toàn bộ thư mục
# bản vẽ. Thiếu biến này thì `docker compose up` dừng kèm thông báo, cố ý không chạy tiếp.
REDIS_PASSWORD=doi-gia-tri-nay-truoc-khi-deploy

# Dung lượng file upload lớn nhất (MB). Mặc định 200.
# MAX_UPLOAD_MB=200

# Giới hạn tần suất cho endpoint tạo việc nặng, tính theo từng danh tính người gọi.
# Đặt RATE_LIMIT_REQUESTS=0 để tắt. LƯU Ý: bộ đếm nằm trong RAM của từng tiến trình, nên
# chạy nhiều worker uvicorn thì hạn mức thực tế là (giới hạn × số worker). Đây là chốt
# chặn chống lạm dụng vô ý, KHÔNG phải phòng thủ trước tấn công từ chối dịch vụ.
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60

# Bản ghi "task này của ai" sống bao lâu (giây). Mặc định 7 ngày.
# TASK_OWNER_TTL=604800

# Buộc /api/v1/autocad/analyze chỉ nhận bản vẽ NẰM TRONG workspace của máy chủ.
# Mặc định TẮT vì endpoint này vốn dành cho kịch bản plugin AutoCAD chạy cùng máy với
# server. Triển khai nhiều người dùng thì PHẢI bật — nếu không, thông báo "không tìm thấy
# file" trở thành câu trả lời có/không cho mọi đường dẫn khách hàng đoán.
# Xem docs/RA_SOAT_LO_HONG.md mục 4.
# MEP_AGENTS_STRICT_PATHS=true

# LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=x_agents_project

# --- Phase C: Postgres / pgvector / S3 / JWT / YOLO ---
# DATABASE_URL=postgresql://mep:mep_secret@localhost:5432/mep_agents
# USE_PGVECTOR=false
# POSTGRES_USER=mep
# POSTGRES_PASSWORD=mep_secret
# POSTGRES_DB=mep_agents

# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=ap-southeast-1
# S3_PREFIX=mep-agents/
# S3_LOCAL_CACHE=/tmp/mep_s3_cache

# Ép checkpointer về sqlite/memory kể cả khi đã có DATABASE_URL
# CHECKPOINT_BACKEND=sqlite

# JWT_SECRET=doi-thanh-chuoi-dai-ngau-nhien
# JWT_BOOTSTRAP_USER=admin
# JWT_BOOTSTRAP_PASSWORD=doi-mat-khau
# JWT_EXPIRE_MINUTES=1440

# YOLO_WEIGHTS=runs/mepf/train/weights/best.pt
# YOLO_CONFIDENCE=0.25
